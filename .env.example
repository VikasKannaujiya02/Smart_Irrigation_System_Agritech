# Environment
ENVIRONMENT=production

# Backend
DATABASE_URL=sqlite:///app/data/sqlite/irrigation.db
LOG_LEVEL=INFO
WEATHER_API_KEY=your_openweathermap_api_key
WEATHER_LATITUDE=0.0
WEATHER_LONGITUDE=0.0

# Database
DB_BACKUP_ENABLED=true
DB_BACKUP_INTERVAL_HOURS=24

# OTA Update
OTA_UPDATE_ENABLED=true
OTA_UPDATE_SERVER=https://ota.example.com
OTA_UPDATE_CHECK_INTERVAL_HOURS=24

# Health Monitoring
HEALTH_CHECK_INTERVAL_SECONDS=60

# Remote Configuration
REMOTE_CONFIG_ENABLED=false
REMOTE_CONFIG_URL=https://config.example.com
